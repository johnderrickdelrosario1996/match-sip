# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API key for Resend email service (https://resend.com)
# Used to dispatch instant admin email alerts on booking confirmation.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Optional verified sender email address (default: "onboarding@resend.dev")
RESEND_FROM_EMAIL=

# ADMIN_EMAIL: Recipient email address for booking alerts (default: "danamieratan@gmail.com")
ADMIN_EMAIL=danamieratan@gmail.com

# PAYMONGO_SECRET_KEY: Secret Key from PayMongo Dashboard (sk_test_... or sk_live_...)
# Used for creating GCash Checkout Sessions and Sources.
PAYMONGO_SECRET_KEY=

# PAYMONGO_PUBLIC_KEY: Public Key from PayMongo Dashboard (pk_test_... or pk_live_...)
PAYMONGO_PUBLIC_KEY=

# PAYMONGO_WEBHOOK_SECRET_KEY: Webhook signing secret (whsk_...) from PayMongo Webhooks tab
# Used to verify HMAC-SHA256 signatures on POST /api/webhooks/payment
PAYMONGO_WEBHOOK_SECRET_KEY=
